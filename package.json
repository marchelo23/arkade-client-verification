{
  "name": "ln-markets-arkade-vtxo",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/vtxoDAGVerification.js",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sec": "vitest run src/__tests__/blackboxSec.test.ts",
    "test:stress": "vitest run src/__tests__/stress_dos.test.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "audit:ci": "bash audit_ci.sh",
    "docker:build": "docker build -t arkade-vtxo-verification .",
    "docker:test": "docker compose run --rm test",
    "docker:audit": "docker compose run --rm audit"
  },
  "keywords": [
    "ark",
    "arkade",
    "bitcoin",
    "vtxo",
    "verification",
    "taproot",
    "musig2",
    "zero-trust"
  ],
  "author": "Marcelo Adrián Guerra Najarro",
  "license": "ISC",
  "description": "Client-side VTXO & Sovereign Exit verification for the Arkade SDK",
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "@scure/btc-signer": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "typescript": "^5.9.3",
    "undici": "^6.27.0",
    "vitest": "^2.1.9"
  }
}
