{
  "name": "@arkade-os/client-verification",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marchelo23/arkade-client-verification.git"
  },
  "bugs": {
    "url": "https://github.com/marchelo23/arkade-client-verification/issues"
  },
  "homepage": "https://github.com/marchelo23/arkade-client-verification#readme",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sec": "vitest run src/__tests__/blackboxSec.test.ts",
    "test:stress": "vitest run src/__tests__/stress_dos.test.ts",
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "audit:ci": "bash audit_ci.sh",
    "docker:build": "docker build -t arkade-client-verification .",
    "docker:test": "docker compose run --rm test",
    "docker:audit": "docker compose run --rm audit"
  },
  "keywords": [
    "ark",
    "arkade",
    "bitcoin",
    "vtxo",
    "verification",
    "taproot",
    "musig2",
    "zero-trust"
  ],
  "author": "Marcelo Adrián Guerra Najarro",
  "license": "MIT",
  "description": "Zero-trust client-side VTXO verification and sovereign exit engine for the Arkade protocol",
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "@scure/btc-signer": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "typescript": "^5.9.3",
    "undici": "^6.27.0",
    "vitest": "^3.2.7"
  }
}
